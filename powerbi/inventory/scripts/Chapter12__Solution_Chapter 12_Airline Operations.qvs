///$tab Main
SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='hh:mm:ss';
SET DateFormat='YYYY-MM-DD';
SET TimestampFormat='YYYY-MM-DD hh:mm:ss[.fff]';
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';

SET vLoadMainData = 'Y';
SET HidePrefix = '%';
///$tab Includes
$(Include=config.qvs);
$(Include=tracerowcount.qvs);
$(Include=SetVariables.txt);
///$tab Mapping
Map_Manufacturer_Country:
MAPPING LOAD Company, 
     Country
FROM
[$(vFolderSourceData)CSVs\Aircraft_Manufacturers.csv]
(txt, codepage is 1252, embedded labels, delimiter is ';', msq);

Map_Table_Comments:
MAPPING LOAD TableName, 
     Comment
FROM
[$(vFolderSourceData)Excel\Comments.xls]
(biff, embedded labels, table is Tables$);

Map_Field_Comments:
MAPPING LOAD FieldName, 
     Comment
FROM
[$(vFolderSourceData)Excel\Comments.xls]
(biff, embedded labels, table is Fields$);
///$tab Comments
COMMENT TABLES USING Map_Table_Comments;
COMMENT FIELDS USING Map_Field_Comments;
///$tab Main Data
IF '$(vLoadMainData)' = 'Y' THEN

[Main Data]:
LOAD [%Airline ID], 
     [%Carrier Group ID], 
     [%Unique Carrier Code], 
     [%Unique Carrier Entity Code], 
     [%Region Code], 
     [%Origin Airport ID], 
     [%Origin Airport Sequence ID], 
     [%Origin Airport Market ID], 
     [%Origin World Area Code], 
     [%Destination Airport ID], 
     [%Destination Airport Sequence ID], 
     [%Destination Airport Market ID], 
     [%Destination World Area Code], 
     [%Aircraft Group ID], 
     [%Aircraft Type ID], 
     [%Aircraft Configuration ID], 
     [%Distance Group ID], 
     [%Service Class ID], 
     [%Datasource ID], 
     [# Departures Scheduled], 
     [# Departures Performed], 
     [# Payload], 
     Distance, 
     [# Available Seats], 
     [# Transported Passengers], 
     [# Transported Freight], 
     [# Transported Mail], 
     [# Ramp-To-Ramp Time], 
     [# Air Time], 
     [Unique Carrier], 
     [Carrier Code], 
     [Carrier Name], 
     [Origin Airport Code], 
     [Origin City], 
     [Origin State Code], 
     [Origin State FIPS], 
     [Origin State], 
     [Origin Country Code], 
     [Origin Country], 
     [Destination Airport Code], 
     [Destination City], 
     [Destination State Code], 
     [Destination State FIPS], 
     [Destination State], 
     [Destination Country Code], 
     [Destination Country], 
//     Year, 
     Period, 
//     Quarter, 
//     [Month (#)], 
//     Month, 
     [From - To Airport Code], 
     [From - To Airport ID], 
     [From - To City], 
     [From - To State Code], 
     [From - To State]
FROM
[$(vFolderSourceData)QVDs\Flight Data.qvd]
(qvd);

END IF
///$tab Employment Data
Concatenate ([Main Data])
LOAD [%Airline ID], 
     [%Unique Carrier Code], 
     [%Carrier Group ID], 
     [# Full Time Employees], 
     [# Part Time Employees], 
     [# Total Employees], 
     [# Equivalent FTEs], 
     [Unique Carrier], 
     [Carrier Code], 
     [Carrier Name], 
//     Year, 
//     'Q' & Ceil([Month (#)]/3, 1) as Quarter,
     Period 
//     [Month (#)], 
//     Month
FROM
[$(vFolderSourceData)QVDs\T_F41SCHEDULE_P1A_EMP.qvd]
(qvd);

///$tab Calendar
//--- Select the lowest and highest periods 
//		from the Flights fact table.

Temp_Calendar_Range:
LOAD
	Num(Date#(Min(Period), 'YYYYMM'))		as MinDate,
	Num(Date#(Max(Period), 'YYYYMM')) 		as MaxDate
RESIDENT [Main Data];

//--- Assign the start and end dates to variables
LET vMinDate = Peek('MinDate', 0, 'Temp_Calendar_Range');
LET vMaxDate = Peek('MaxDate', 0, 'Temp_Calendar_Range');

DROP TABLE Temp_Calendar_Range; // Cleanup

[Master Calendar]:
Load *,
	 AutoNumber(Year & Quarter, 'QuarterID') 		as [QuarterID],
	 AutoNumber(Period, 'PeriodID') 				as [PeriodID]
	 ;
LOAD DISTINCT
	Year(Temp_Date) * 100 + Month(Temp_Date) 		as [Period],
	Year(Temp_Date)								  	as [Year],	
	Month(Temp_Date)								as [Month],	
	Date(Temp_Date, 'YYYY-MM')					  	as [Year - Month],
	'Q' & Ceil(Month(Temp_Date) / 3)			  	as [Quarter]
	;
LOAD DISTINCT
	MonthStart($(vMinDate) + IterNo() - 1)   as Temp_Date	
AUTOGENERATE (1)
WHILE $(vMinDate) + IterNo() - 1 <= $(vMaxDate);


//--- Remove the temporary variables
LET vMinDate = Null();
LET vMaxDate = Null();
///$tab Airlines
[Carrier Groups]: 
	LOAD [%Carrier Group ID], 
		 [%Carrier Group ID] as [Temp_Carrier_Group_ID],
	     [Carrier Group]
	FROM
	[$(vFolderSourceData)QVDs\Carrier Groups.qvd]
	(qvd)
		Where Exists([%Carrier Group ID]);

Concatenate ([Carrier Groups])
	Load Distinct
		 [%Carrier Group ID],
		 'Unknown' as [Carrier Group]
	Resident [Main Data]
		 Where not Exists([Temp_Carrier_Group_ID], [%Carrier Group ID]);

Drop Field [Temp_Carrier_Group_ID];

Airlines:
	LOAD [%Airline ID], 
	     Airline
	FROM
	[$(vFolderSourceData)QVDs\Airlines.qvd]
	(qvd)
		Where Exists([%Airline ID]);

[Carrier Operating Region]:
	LOAD [%Region Code], 
		 [%Region Code] as [Temp_Region_Code],
	     [Carrier's Operating Region]
	FROM
	[$(vFolderSourceData)QVDs\Carrier Operating Region.qvd]
	(qvd)
		Where Exists([%Region Code]);

Concatenate ([Carrier Operating Region])
	Load Distinct
		 [%Region Code],
		 'Unknown' as [Carrier's Operating Region]
	Resident [Main Data]
		 Where not Exists([Temp_Region_Code], [%Region Code]);

DROP Field [Temp_Region_Code];

[Flight Types]:
	LOAD [%Datasource ID], 
	     [Flight Type]
	FROM
	[$(vFolderSourceData)QVDs\Flight Types.qvd]
	(qvd)
		Where Exists([%Datasource ID]);
	
///$tab Aircrafts
//========================================[ Aircraft Types ]========================================

[Aircraft Types]:
LOAD 
	 AC_TYPEID 											as [%Aircraft Type ID], 
     AC_GROUP 											as [%Aircraft Group Type], 
     SSD_NAME 											as [Aircraft Name], 
     MANUFACTURER 										as [Aircraft Manufacturer], 
     ApplyMap('Map_Manufacturer_Country', 
     		   MANUFACTURER, 'Unknown') 				as [Aircraft Manufacturer Country], 
     LONG_NAME 											as [Aircraft Name Full], 
     SHORT_NAME 										as [Aircraft Name Abbreviated], 
     BEGIN_DATE 										as [Aircraft Begin Date], 
     END_DATE 											as [Aircraft End Date],
     If(Year(BEGIN_DATE) < 1990, 
     	'Classic', 'Current') 							as [Aircraft Age Classification]
FROM
[$(vFolderSourceData)CSVs\Aircraft_Base_File.csv]
(txt, codepage is 1252, embedded labels, delimiter is ';', msq)
	Where Exists([%Aircraft Type ID], AC_TYPEID);

CALL TraceRowCount('Aircraft Types');

//--- Add the engine configuration information to the aircraft data
LEFT JOIN ([Aircraft Types])
LOAD 
	 [Aircraft Group ID] 								as [%Aircraft Group Type], //*** Key field
     [Aircraft Engine Type], 
     [Aircraft Number Of Engines]
FROM
[$(vFolderSourceData)CSVs\Aircraft_Group.csv]
(txt, codepage is 1252, embedded labels, delimiter is ';', msq);


CALL TraceRowCount('Aircraft Types');

//--- No longer this key as we just joined the Engine Type and Number of Engines
//    to the Aircraft Types table.
DROP FIELD [%Aircraft Group Type] FROM [Aircraft Types];

//--- Add the 2010 update to the Aircraft Types table.
CONCATENATE([Aircraft Types])
LOAD 
	 AC_TYPEID 											as [%Aircraft Type ID], 
     SubField(AC_GROUPNAME, ', ', 1)					as [Aircraft Engine Type],         //--- 2010 files already contains
     SubField(AC_GROUPNAME, ', ', 2) 					as [Aircraft Number Of Engines],   //    the engine configuration.
     SSD_NAME 											as [Aircraft Name], 
     MANUFACTURER 										as [Aircraft Manufacturer], 
     ApplyMap('Map_Manufacturer_Country', 
     		   MANUFACTURER, 'Unknown') 				as [Aircraft Manufacturer Country],
     LONG_NAME 											as [Aircraft Name Full], 
     SHORT_NAME 										as [Aircraft Name Abbreviated], 
     BEGIN_DATE 										as [Aircraft Begin Date], 
     END_DATE 											as [Aircraft End Date],
     'Current' 											as [Aircraft Age Classification] //--- No need to check, the 2010 file only contains 
FROM                                            										 //    recent aircrafts.
[$(vFolderSourceData)CSVs\Aircraft_2010_Update.csv]
(txt, codepage is 1252, embedded labels, delimiter is ';', msq)
	Where Exists([%Aircraft Type ID], AC_TYPEID);

//--- Store transformed QVD
STORE [Aircraft Types] INTO '$(vFolderSourceData)QVDs\Aircraft Types Transformed.qvd' (qvd);
///$tab Airports
[Distance Groups]:
	LOAD [%Distance Group ID], 
	     [Distance Interval]
	FROM
	[$(vFolderSourceData)QVDs\Distance Groups.qvd]
	(qvd)
		Where Exists([%Distance Group ID]);
	
OLEDB CONNECT32 TO [Provider=Microsoft.Jet.OLEDB.4.0;User ID=Admin;Data Source=$(vFolderSourceData)MDBs\Dimension Tables.mdb;Mode=Share Deny None;Extended Properties="";Jet OLEDB:System database="";Jet OLEDB:Registry Path="";Jet OLEDB:Database Password="";Jet OLEDB:Engine Type=5;Jet OLEDB:Database Locking Mode=1;Jet OLEDB:Global Partial Bulk Ops=2;Jet OLEDB:Global Bulk Transactions=1;Jet OLEDB:New Database Password="";Jet OLEDB:Create System Database=False;Jet OLEDB:Encrypt Database=False;Jet OLEDB:Don't Copy Locale on Compact=False;Jet OLEDB:Compact Without Replica Repair=False;Jet OLEDB:SFP=False];

[Origin Airports]:
	Left Keep ([Main Data])
	LOAD `%Origin Airport ID`,
	    `Origin Airport`;
	SQL SELECT *
	FROM `Origin Airports`;

[Destination Airports]:
	Left Keep ([Main Data])
	LOAD `%Destination Airport ID`,
	    `Destination Airport`;
	SQL SELECT *
	FROM `Destination Airports`;
	
[Origin Markets]:
	LOAD [%Origin Airport Market ID], 
		 [%Origin Airport Market ID] as [Temp_Origin_Airport_Market_ID], 
	     [Origin Market]
	FROM
	[$(vFolderSourceData)CSVs\Origin Markets.csv]
	(txt, codepage is 1252, embedded labels, delimiter is '\t', msq)
		Where Exists([%Origin Airport Market ID]);

Concatenate([Origin Markets])
	Load Distinct
		 [%Origin Airport Market ID],
		 'Unknown' as [Origin Market]
	Resident [Main Data]
		 Where not Exists([Temp_Origin_Airport_Market_ID], [%Origin Airport Market ID]);

Drop Field [Temp_Origin_Airport_Market_ID];

[Destination Markets]:
	LOAD [%Destination Airport Market ID], 
		 [%Destination Airport Market ID] as [Temp_Destination_Airport_Market_ID],  
	     [Destination Market]
	FROM
	[$(vFolderSourceData)CSVs\Destination Markets.csv]
	(txt, codepage is 1252, embedded labels, delimiter is '\t', msq)
		Where Exists([%Destination Airport Market ID]);

Concatenate([Destination Markets])
	Load Distinct
		 [%Destination Airport Market ID],
		 'Unknown' as [Destination Market]
	Resident [Main Data]
		 Where not Exists([Temp_Destination_Airport_Market_ID], [%Destination Airport Market ID]);

Drop Field [Temp_Destination_Airport_Market_ID];
///$tab Metrics
LOAD * INLINE [
    Metric Name				, eMetric
    # of Flights			, eDeparturesPerformed
    Enplaned Passengers		, eEnplanedPassengers
    Air Time				, eAirTime
];
