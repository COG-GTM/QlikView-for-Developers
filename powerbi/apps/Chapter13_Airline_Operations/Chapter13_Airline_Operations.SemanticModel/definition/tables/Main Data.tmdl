		lineageTag: ee15fc43-fa68-5cb4-8c23-5a031790bd3a

		annotation ParityKey = c61bbcf8a5bc
		annotation QlikExpression = Sum({$<$(vSetPreviousNMonth(2))>} [# Departures Performed])
		annotation QlikObjects = CH65#4

	measure 'Group A Flights' = CALCULATE([# of Flights], KEEPFILTERS(TREATAS(VALUES('Group A'[Group A Period]), 'Master Calendar'[Period])))
		formatString: #,0
		lineageTag: f4dc6f44-aac3-5921-9ce4-84637d1090d8

		annotation ParityKey = 233f869eae9d
		annotation QlikExpression = Sum({[Group A] * $} [# Departures Performed])
		annotation QlikObjects = CH66#1, CH67#1

	measure 'Group B Flights' = CALCULATE([# of Flights], KEEPFILTERS(TREATAS(VALUES('Group B'[Group B Period]), 'Master Calendar'[Period])))
		formatString: #,0
		lineageTag: dd57e24a-d9ee-5813-ade2-efafea43db2e

		annotation ParityKey = 6ba2cbf5d1e6
		annotation QlikExpression = Sum({[Group B] * $} [# Departures Performed])
		annotation QlikObjects = CH66#2, CH67#2

	measure 'Full Time HC Change' = SUM('Main Data'[# M-Delta Full Time Employees])
		formatString: #,0
		lineageTag: 1e41c557-ea0a-54ce-bdce-198070ab6162

		annotation ParityKey = 97885edb520e
		annotation QlikExpression = Sum([# M-Delta Full Time Employees])
		annotation QlikObjects = CH68#1

	measure 'Part Time HC Change' = SUM('Main Data'[# M-Delta Part Time Employees])
		formatString: #,0
		lineageTag: 8e45250d-8607-5aa1-b5f5-05f91ca1e4b5

		annotation ParityKey = bebebe28ced0
		annotation QlikExpression = Sum([# M-Delta Part Time Employees])
		annotation QlikObjects = CH68#2

	measure 'Total HC Change' = SUM('Main Data'[# M-Delta Total Employees])
		formatString: #,0
		lineageTag: d36d7eef-20fd-5532-8239-54a46d2c7edf

		annotation ParityKey = 53f3fabda737
		annotation QlikExpression = Sum([# M-Delta Total Employees])
		annotation QlikObjects = CH68#3, CH69#3

	measure 'Total HC Change MTD' = VAR y = CALCULATE(MAX('Master Calendar'[Year]), ALLSELECTED()) - 0 VAR mo = CALCULATE(MAX('Master Calendar'[Month__num]), ALLSELECTED()) RETURN CALCULATE(SUM('Main Data'[# M-Delta Total Employees]), REMOVEFILTERS('Master Calendar'), 'Master Calendar'[Year] = y, 'Master Calendar'[Month__num] = mo)
		formatString: #,0
		lineageTag: e0260b39-5e20-51da-86a1-686dd7a85077

		annotation ParityKey = bdf635c244a3
		annotation QlikExpression = Sum({$<$(vSetMTD)>} [# M-Delta Total Employees])
		annotation QlikObjects = CH69#1

	measure 'Total HC Change YTD' = VAR y = CALCULATE(MAX('Master Calendar'[Year]), ALLSELECTED()) - 0 VAR mo = CALCULATE(MAX('Master Calendar'[Month__num]), ALLSELECTED()) RETURN CALCULATE(SUM('Main Data'[# M-Delta Total Employees]), REMOVEFILTERS('Master Calendar'), 'Master Calendar'[Year] = y, 'Master Calendar'[Month__num] <= mo)
		formatString: #,0
		lineageTag: 91910782-aba8-5da7-8a59-a87625c94dd6

		annotation ParityKey = 04c961e41f32
		annotation QlikExpression = Sum({$<$(vSetYTD)>} [# M-Delta Total Employees])
		annotation QlikObjects = CH69#2

	measure 'FTEs MTD' = VAR y = CALCULATE(MAX('Master Calendar'[Year]), ALLSELECTED()) - 0 VAR mo = CALCULATE(MAX('Master Calendar'[Month__num]), ALLSELECTED()) RETURN CALCULATE(SUM('Main Data'[# Equivalent FTEs]), REMOVEFILTERS('Master Calendar'), 'Master Calendar'[Year] = y, 'Master Calendar'[Month__num] = mo)
		formatString: #,0
		lineageTag: e98ce98f-8c02-5ee7-800c-30850dda10fb

		annotation ParityKey = d76da9774b00
		annotation QlikExpression = Sum({$<$(vSetMTD)>} [# Equivalent FTEs])
		annotation QlikObjects = CH70#1

