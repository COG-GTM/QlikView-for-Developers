	partition 'Master Calendar' = m
		mode: import
		source =
				let
				    Periods = List.RemoveNulls(fnFactKeys("Period")),
				    MinDate = #date(Number.IntegerDivide(List.Min(Periods), 100), Number.Mod(List.Min(Periods), 100), 1),
				    MaxDate = #date(Number.IntegerDivide(List.Max(Periods), 100), Number.Mod(List.Max(Periods), 100), 1),
				    Months = List.Generate(() => MinDate, each _ <= MaxDate, each Date.AddMonths(_, 1)),
				    Base = Table.FromList(Months, Splitter.SplitByNothing(), {"MonthStart"}),
				    Indexed = Table.AddIndexColumn(Base, "PeriodID", 1, 1),
				    Cols = Table.AddColumn(Indexed, "Fields", each [Period = Date.Year([MonthStart]) * 100 + Date.Month([MonthStart]), Year = Date.Year([MonthStart]), Month = Date.ToText([MonthStart], "MMM", "en-US"), Month__num = Date.Month([MonthStart]), #"Year - Month" = Date.ToText([MonthStart], "yyyy-MM", "en-US"), #"Year - Month__num" = Number.From([MonthStart]), Quarter = "Q" & Text.From(Number.RoundUp(Date.Month([MonthStart]) / 3)), QuarterID = (Date.Year([MonthStart]) - Date.Year(MinDate)) * 4 + Number.RoundUp(Date.Month([MonthStart]) / 3) - Number.RoundUp(Date.Month(MinDate) / 3) + 1]),
				    Expanded = Table.ExpandRecordColumn(Cols, "Fields", {"Period", "Year", "Month", "Month__num", "Year - Month", "Year - Month__num", "Quarter", "QuarterID"}),
				    Selected = Table.SelectColumns(Expanded, {"Period", "Year", "Month", "Month__num", "Year - Month", "Year - Month__num", "Quarter", "QuarterID", "PeriodID"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"Period", Int64.Type}, {"Year", Int64.Type}, {"Month", type text}, {"Month__num", type number}, {"Year - Month", type text}, {"Year - Month__num", type number}, {"Quarter", type text}, {"QuarterID", Int64.Type}, {"PeriodID", Int64.Type}})
				in
				    Typed
