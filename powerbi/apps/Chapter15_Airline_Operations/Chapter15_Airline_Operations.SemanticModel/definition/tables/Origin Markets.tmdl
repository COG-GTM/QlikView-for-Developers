table 'Origin Markets'
	lineageTag: 84e8cc6e-855b-544e-8748-ac1cf6398bd9

	column '%Origin Airport Market ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8165dea1-dc2d-57f0-bc09-ac3c769a2e47
		summarizeBy: none
		sourceColumn: %Origin Airport Market ID

		annotation SummarizationSetBy = Automatic

	column 'Origin Market'
		dataType: string
		lineageTag: 5b180449-d138-5f52-97a8-a783ba2d2cb8
		summarizeBy: none
		sourceColumn: Origin Market

		annotation SummarizationSetBy = Automatic

	partition 'Origin Markets' = m
		mode: import
		source =
				let
				    Source = Table.SelectColumns(fnReadParquet("QVD/Source/Origin Markets.parquet"), {"%Origin Airport Market ID", "Origin Market"}),
				    FactKeys = List.Buffer(List.RemoveNulls(fnFactKeys("%Origin Airport Market ID"))),
				    Kept = Table.SelectRows(Source, each List.Contains(FactKeys, [#"%Origin Airport Market ID"])),
				    Missing = List.Difference(FactKeys, Table.Column(Kept, "%Origin Airport Market ID")),
				    Unknown = Table.FromColumns({Missing, List.Repeat({"Unknown"}, List.Count(Missing))}, {"%Origin Airport Market ID", "Origin Market"}),
				    Combined = Table.Combine({Kept, Unknown}),
				    Typed = Table.TransformColumnTypes(Combined, {{"%Origin Airport Market ID", Int64.Type}, {"Origin Market", type text}})
				in
				    Typed
