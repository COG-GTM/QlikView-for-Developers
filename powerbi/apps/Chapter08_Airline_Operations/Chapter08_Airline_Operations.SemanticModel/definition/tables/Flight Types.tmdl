table 'Flight Types'
	lineageTag: 32cdcd55-6464-58e0-a1f7-98be0b01f535

	column '%Datasource ID'
		dataType: string
		isHidden
		lineageTag: 6603ce32-2e5c-5991-b93d-9cd99daff833
		summarizeBy: none
		sourceColumn: %Datasource ID

		annotation SummarizationSetBy = Automatic

	column 'Flight Type'
		dataType: string
		lineageTag: e7a42fa8-2243-5152-a559-70fb1acdd5fb
		summarizeBy: none
		sourceColumn: Flight Type

		annotation SummarizationSetBy = Automatic

	column 'Deal Status' = SWITCH([Flight Type], "Domestic, US Carriers Only", "Open", "International, Foreign Carriers", "Negotiating", "Closed")
		dataType: string
		lineageTag: d54d939f-a546-5a3a-b2ad-ff318cb32f3c
		summarizeBy: none

		annotation ParityKey = caa19c70b731
		annotation QlikDimension = =if([Flight Type]='Domestic, US Carriers Only', 'Open', if([Flight Type]='International, Foreign Carriers', 'Negotiating', 'Closed'))

	partition 'Flight Types' = m
		mode: import
		source =
				let
				    Source = fnReadParquet("Data Files/QVDs/Flight Types.parquet"),
				    Selected = Table.SelectColumns(Source, {"%Datasource ID", "Flight Type"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"%Datasource ID", type text}, {"Flight Type", type text}})
				in
				    Typed
