model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["DataRoot", "fnReadParquet", "Main Data", "Carrier Groups", "Airlines", "Carrier Operating Region", "Flight Types", "Aircraft Groups", "Aircraft Types", "Distance Groups"]

ref table 'Main Data'
ref table 'Carrier Groups'
ref table Airlines
ref table 'Carrier Operating Region'
ref table 'Flight Types'
ref table 'Aircraft Groups'
ref table 'Aircraft Types'
ref table 'Distance Groups'
