	partition 'Employment Statistics' = m
		mode: import
		source =
				let
				    Source = fnReadParquet("Data Files/QVDs/T_F41SCHEDULE_P1A_EMP.parquet"),
				    Keyed = Table.AddColumn(Source, "%Key Field", each fnText(_[#"Period"]) & " | " & fnText(_[#"%Airline ID"]) & " | " & fnText(_[#"%Unique Carrier Code"]) & " | " & fnText(_[#"%Carrier Group ID"]), type text),
				    Selected = Table.SelectColumns(Keyed, {"%Key Field", "# Full Time Employees", "# Part Time Employees", "# Total Employees", "# Equivalent FTEs"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"%Key Field", type text}, {"# Full Time Employees", Int64.Type}, {"# Part Time Employees", Int64.Type}, {"# Total Employees", Int64.Type}, {"# Equivalent FTEs", Int64.Type}})
				in
				    Typed
