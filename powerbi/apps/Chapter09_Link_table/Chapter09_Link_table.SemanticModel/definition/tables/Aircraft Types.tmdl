		sourceColumn: Aircraft Number Of Engines

		annotation SummarizationSetBy = Automatic

	partition 'Aircraft Types' = m
		mode: import
		source =
				let
				    FactKeys = List.Buffer(List.RemoveNulls(fnFactKeys("%Aircraft Type ID"))),
				    // MAPPING LOAD: the first Country of each manufacturer,
				    Manufacturers = Table.Buffer(Table.Distinct(fnReadParquet("Data Files/CSVs/Aircraft_Manufacturers.parquet"), {"Company"})),
				    ApplyMap = (t as table) => Table.ReplaceValue(Table.ExpandTableColumn(Table.NestedJoin(t, {"MANUFACTURER"}, Manufacturers, {"Company"}, "Map", JoinKind.LeftOuter), "Map", {"Country"}), null, "Unknown", Replacer.ReplaceValue, {"Country"}),
				    BaseFile = Table.SelectRows(fnReadParquet("Data Files/CSVs/Aircraft_Base_File.parquet"), each List.Contains(FactKeys, [AC_TYPEID])),
				    Aged = Table.AddColumn(ApplyMap(BaseFile), "Aircraft Age Classification", each if [BEGIN_DATE] <> null and Date.Year([BEGIN_DATE]) < 1990 then "Classic" else "Current", type text),
				    // LEFT JOIN Aircraft_Group.csv; QlikView trims unquoted delimited text,
				    Groups = Table.TransformColumns(fnReadParquet("Data Files/CSVs/Aircraft_Group.parquet"), {{"Aircraft Engine Type", Text.Trim}, {"Aircraft Number Of Engines", Text.Trim}}),
				    Joined = Table.ExpandTableColumn(Table.NestedJoin(Aged, {"AC_GROUP"}, Groups, {"Aircraft Group ID"}, "Group", JoinKind.LeftOuter), "Group", {"Aircraft Engine Type", "Aircraft Number Of Engines"}),
				    Update = Table.SelectRows(fnReadParquet("Data Files/CSVs/Aircraft_2010_Update.parquet"), each List.Contains(FactKeys, [AC_TYPEID])),
				    Split = Table.AddColumn(Table.AddColumn(Table.AddColumn(ApplyMap(Update), "Aircraft Engine Type", each Text.BeforeDelimiter([AC_GROUPNAME], ", "), type text), "Aircraft Number Of Engines", each if Text.Contains([AC_GROUPNAME], ", ") then Text.Split([AC_GROUPNAME], ", "){1} else null, type text), "Aircraft Age Classification", each "Current", type text),
				    Combined = Table.Combine({Joined, Split}),
				    Renamed = Table.RenameColumns(Combined, {{"SSD_NAME", "Aircraft Name"}, {"MANUFACTURER", "Aircraft Manufacturer"}, {"Country", "Aircraft Manufacturer Country"}, {"LONG_NAME", "Aircraft Name Full"}, {"SHORT_NAME", "Aircraft Name Abbreviated"}, {"BEGIN_DATE", "Aircraft Begin Date"}, {"END_DATE", "Aircraft End Date"}, {"AC_TYPEID", "%Aircraft Type ID"}}),
				    Selected = Table.SelectColumns(Renamed, {"%Aircraft Type ID", "Aircraft Name", "Aircraft Manufacturer", "Aircraft Manufacturer Country", "Aircraft Name Full", "Aircraft Name Abbreviated", "Aircraft Begin Date", "Aircraft End Date", "Aircraft Age Classification", "Aircraft Engine Type", "Aircraft Number Of Engines"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"%Aircraft Type ID", Int64.Type}, {"Aircraft Name", type text}, {"Aircraft Manufacturer", type text}, {"Aircraft Manufacturer Country", type text}, {"Aircraft Name Full", type text}, {"Aircraft Name Abbreviated", type text}, {"Aircraft Begin Date", type date}, {"Aircraft End Date", Int64.Type}, {"Aircraft Age Classification", type text}, {"Aircraft Engine Type", type text}, {"Aircraft Number Of Engines", type text}})
				in
				    Typed
