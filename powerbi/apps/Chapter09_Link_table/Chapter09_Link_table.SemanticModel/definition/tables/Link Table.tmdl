		annotation SummarizationSetBy = Automatic

	partition 'Link Table' = m
		mode: import
		source =
				let
				    Flight = fnReadParquet("Data Files/QVDs/Flight Data.parquet"),
				    FlightKeyed = Table.AddColumn(Flight, "%Key Field", each fnText(_[#"Period"]) & " | " & fnText(_[#"%Airline ID"]) & " | " & fnText(_[#"%Unique Carrier Code"]) & " | " & fnText(_[#"%Carrier Group ID"]), type text),
				    FlightLinks = Table.Buffer(Table.Distinct(Table.SelectColumns(FlightKeyed, {"%Key Field", "Year", "Period", "Month (#)", "Month", "Month__num", "Quarter", "%Airline ID", "%Unique Carrier Code", "%Carrier Group ID", "Unique Carrier", "Carrier Code", "Carrier Name"}))),
				    Employment = fnReadParquet("Data Files/QVDs/T_F41SCHEDULE_P1A_EMP.parquet"),
				    EmploymentKeyed = Table.AddColumn(Employment, "%Key Field", each fnText(_[#"Period"]) & " | " & fnText(_[#"%Airline ID"]) & " | " & fnText(_[#"%Unique Carrier Code"]) & " | " & fnText(_[#"%Carrier Group ID"]), type text),
				    WithQuarter = Table.AddColumn(EmploymentKeyed, "Quarter", each "Q" & Text.From(Number.RoundUp([#"Month (#)"] / 3)), type text),
				    EmploymentLinks = Table.Distinct(Table.SelectColumns(WithQuarter, {"%Key Field", "Year", "Period", "Month (#)", "Month", "Month__num", "Quarter", "%Airline ID", "%Unique Carrier Code", "%Carrier Group ID", "Unique Carrier", "Carrier Code", "Carrier Name"})),
				    // Where Not Exists([%TEMP Key Field], [%Key Field]): employment keys no flight row has,
				    NewKeys = Table.NestedJoin(EmploymentLinks, {"%Key Field"}, FlightLinks, {"%Key Field"}, "Flight", JoinKind.LeftAnti),
				    Combined = Table.Combine({FlightLinks, Table.RemoveColumns(NewKeys, {"Flight"})}),
				    Typed = Table.TransformColumnTypes(Combined, {{"%Key Field", type text}, {"Year", Int64.Type}, {"Period", Int64.Type}, {"Month (#)", Int64.Type}, {"Month", type text}, {"Month__num", type number}, {"Quarter", type text}, {"%Airline ID", Int64.Type}, {"%Unique Carrier Code", type text}, {"%Carrier Group ID", Int64.Type}, {"Unique Carrier", type text}, {"Carrier Code", type text}, {"Carrier Name", type text}})
				in
				    Typed
