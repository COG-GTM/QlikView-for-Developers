table 'Origin Markets'
	lineageTag: 9c4bdad5-cb3f-5e00-bc95-df22568bb0a4

	column '%Origin Airport Market ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3c4193cc-e631-500d-98ee-c9b4b444bc1f
		summarizeBy: none
