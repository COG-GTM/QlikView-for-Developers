		level Child4
			lineageTag: d4fbbabf-07dc-5d4a-9c8c-2695d979cdef
			column: Child4

	partition 'Sheet1$-ExpandedNodes' = m
		mode: import
		source =
				let
				    Source = fnReadParquet("Chapter10/Hierarchy example/Sheet1.parquet"),
				    Selected = Table.SelectColumns(Source, {"Parent_ID", "Child_ID", "Parent", "Child"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"Parent_ID", Int64.Type}, {"Child_ID", Int64.Type}, {"Parent", type text}, {"Child", type text}})
				in
				    Typed
