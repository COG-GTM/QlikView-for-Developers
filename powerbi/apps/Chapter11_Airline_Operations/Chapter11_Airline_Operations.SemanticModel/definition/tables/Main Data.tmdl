		lineageTag: 03bfc193-0c14-5835-a53e-8f6cb803323d

		annotation ParityKey = 0c8ca154aacf
		annotation QlikExpression = ((Sum ([# Transported Passengers]) / 1000000))
		annotation QlikObjects = CH03#1, CH22#1, CH24#1, CH25#1, CH26#1, CH27#1, CH28#1, CH47#1

	measure '# of Available Seats (millions)' = DIVIDE(SUM('Main Data'[# Available Seats]), 1000000)
		formatString: #,0.00
		lineageTag: daef0755-d134-5318-a9b9-86a6f69f643f

