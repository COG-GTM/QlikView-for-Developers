	partition 'Carrier Operating Region' = m
		mode: import
		source =
				let
				    Source = Table.SelectColumns(fnReadParquet("Data Files/QVDs/Carrier Operating Region.parquet"), {"%Region Code", "Carrier's Operating Region"}),
				    FactKeys = List.Buffer(List.RemoveNulls(fnFactKeys("%Region Code"))),
				    Kept = Table.SelectRows(Source, each List.Contains(FactKeys, [#"%Region Code"])),
				    Missing = List.Difference(FactKeys, Table.Column(Kept, "%Region Code")),
				    Unknown = Table.FromColumns({Missing, List.Repeat({"Unknown"}, List.Count(Missing))}, {"%Region Code", "Carrier's Operating Region"}),
				    Combined = Table.Combine({Kept, Unknown}),
				    Typed = Table.TransformColumnTypes(Combined, {{"%Region Code", type text}, {"Carrier's Operating Region", type text}})
				in
				    Typed
