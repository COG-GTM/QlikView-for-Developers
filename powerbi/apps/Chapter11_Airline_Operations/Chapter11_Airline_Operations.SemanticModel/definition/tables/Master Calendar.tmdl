	column Quarter
		dataType: string
		lineageTag: 16d31c6d-6d25-57a6-aa75-0146f17c7d03
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	partition 'Master Calendar' = m
		mode: import
		source =
				let
				    Periods = List.RemoveNulls(fnFactKeys("Period")),
				    MinDate = #date(Number.IntegerDivide(List.Min(Periods), 100), Number.Mod(List.Min(Periods), 100), 1),
				    MaxDate = #date(Number.IntegerDivide(List.Max(Periods), 100), Number.Mod(List.Max(Periods), 100), 1),
				    Months = List.Generate(() => MinDate, each _ <= MaxDate, each Date.AddMonths(_, 1)),
				    Base = Table.FromList(Months, Splitter.SplitByNothing(), {"MonthStart"}),
				    Cols = Table.AddColumn(Base, "Fields", each [Period = Date.Year([MonthStart]) * 100 + Date.Month([MonthStart]), Year = Date.Year([MonthStart]), Month = Date.ToText([MonthStart], "MMM", "en-US"), Month__num = Date.Month([MonthStart]), #"Year - Month" = Date.ToText([MonthStart], "yyyy-MM", "en-US"), #"Year - Month__num" = Number.From([MonthStart]), Quarter = "Q" & Text.From(Number.RoundUp(Date.Month([MonthStart]) / 3))]),
				    Expanded = Table.ExpandRecordColumn(Cols, "Fields", {"Period", "Year", "Month", "Month__num", "Year - Month", "Year - Month__num", "Quarter"}),
				    Typed = Table.TransformColumnTypes(Expanded, {{"Period", Int64.Type}, {"Year", Int64.Type}, {"Month", type text}, {"Month__num", type number}, {"Year - Month", type text}, {"Year - Month__num", type number}, {"Quarter", type text}})
				in
				    Typed
