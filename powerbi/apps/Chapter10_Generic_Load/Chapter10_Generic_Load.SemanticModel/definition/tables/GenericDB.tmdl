	partition GenericDB = m
		mode: import
		source =
				let
				    Source = fnReadParquet("Chapter10/Generic DB/GenericDB.parquet"),
				    Selected = Table.SelectColumns(Source, {"Object", "Attribute", "Value"}),
				    // GENERIC LOAD: one column per Attribute; no aggregation, so a repeated Object/Attribute pair is an error
				    Pivoted = Table.Pivot(Selected, {"Color", "Weight", "Diameter", "Value", "Thickness"}, "Attribute", "Value"),
				    Typed = Table.TransformColumnTypes(Pivoted, {{"Object", type text}, {"Color", type text}, {"Weight", type text}, {"Diameter", type text}, {"Value", Int64.Type}, {"Thickness", type text}})
				in
				    Typed

	annotation QlikTables = GenericDB.Color, GenericDB.Weight, GenericDB.Diameter, GenericDB.Value, GenericDB.Thickness
