		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["DataRoot", "fnReadParquet", "fnFactKeys", "Main Data", "Carrier Groups", "Airlines", "Carrier Operating Region", "Flight Types", "Distance Groups", "Origin Airports", "Destination Airports", "Origin Markets", "Destination Markets", "Aircraft Types"]

ref table 'Main Data'
ref table 'Carrier Groups'
ref table Airlines
ref table 'Carrier Operating Region'
ref table 'Flight Types'
ref table 'Distance Groups'
ref table 'Origin Airports'
ref table 'Destination Airports'
ref table 'Origin Markets'
ref table 'Destination Markets'
ref table 'Aircraft Types'
