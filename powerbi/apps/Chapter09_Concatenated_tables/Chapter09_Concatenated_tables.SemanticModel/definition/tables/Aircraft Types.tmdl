/// Dimension containing information on aircrafts, including engine types and configuration and manufacturer
table 'Aircraft Types'
	lineageTag: 98ad2497-fcb9-56e1-87f1-f6aa79e7d7b4

	/// Primary key of the Aircraft Type dimension
	column '%Aircraft Type ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6839fd88-84f9-5c83-9443-1c6c72e092d7
		summarizeBy: none
		sourceColumn: %Aircraft Type ID

		annotation SummarizationSetBy = Automatic

	/// The name of the aircraft
	column 'Aircraft Name'
		dataType: string
		lineageTag: 26ed8fcf-8e48-5c34-84fe-121c9a10aaea
		summarizeBy: none
		sourceColumn: Aircraft Name

		annotation SummarizationSetBy = Automatic

	/// The name of the manufacturer of the aircraft, left blank when the aircraft is a generic type
	column 'Aircraft Manufacturer'
		dataType: string
		lineageTag: c0e07e74-f919-5e4b-8ff4-6e741118b98c
		summarizeBy: none
		sourceColumn: Aircraft Manufacturer

		annotation SummarizationSetBy = Automatic

	/// The country in which the manufacturer of the aircraft is based
	column 'Aircraft Manufacturer Country'
		dataType: string
		lineageTag: b32cb205-a158-5b0a-ac0d-93f76920d349
		summarizeBy: none
		sourceColumn: Aircraft Manufacturer Country

		annotation SummarizationSetBy = Automatic

	/// The full name of the aircraft
	column 'Aircraft Name Full'
		dataType: string
		lineageTag: 949b3fe8-bdb0-56a9-b547-003022456d9c
		summarizeBy: none
		sourceColumn: Aircraft Name Full

		annotation SummarizationSetBy = Automatic

	/// The abbreviated name of the aircraft
	column 'Aircraft Name Abbreviated'
		dataType: string
		lineageTag: 375062e5-0bef-5bb2-bf18-30e23cac6ad8
		summarizeBy: none
		sourceColumn: Aircraft Name Abbreviated

		annotation SummarizationSetBy = Automatic

	/// The date when the aircraft was first entered into the database
	column 'Aircraft Begin Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 16340c29-ed79-503c-aacc-133109939e1e
		summarizeBy: none
		sourceColumn: Aircraft Begin Date

		annotation SummarizationSetBy = Automatic

	/// The date when the aircraft was removed from the database
	column 'Aircraft End Date'
		dataType: int64
		formatString: 0
		lineageTag: 735c6a66-c145-5aab-8af1-d0daf462ddd7
		summarizeBy: none
		sourceColumn: Aircraft End Date

		annotation SummarizationSetBy = Automatic

	column 'Aircraft Age Classification'
		dataType: string
		lineageTag: 2a7ce07f-9fdd-5b49-9da6-0a366f6052eb
		summarizeBy: none
		sourceColumn: Aircraft Age Classification

		annotation SummarizationSetBy = Automatic

	/// The engine type of the aircraft: Helicopter, Piston, Turbo-Prop or Jet
	column 'Aircraft Engine Type'
		dataType: string
		lineageTag: d90543c8-ca6c-54b6-ba5a-463a68174cba
		summarizeBy: none
		sourceColumn: Aircraft Engine Type

		annotation SummarizationSetBy = Automatic

	/// The number of engines on the aircraft
	column 'Aircraft Number Of Engines'
		dataType: string
		lineageTag: 599c5025-7a97-5ca4-bc49-f97f0ca945f8
		summarizeBy: none
		sourceColumn: Aircraft Number Of Engines

		annotation SummarizationSetBy = Automatic

	partition 'Aircraft Types' = m
		mode: import
		source =
				let
				    // MAPPING LOAD Company, Country (Aircraft_Manufacturers.csv); ApplyMap(..., MANUFACTURER, 'Unknown')
				    Manufacturers = fnReadParquet("Data Files/CSVs/Aircraft_Manufacturers.parquet"),
				    CountryMap = Record.FromList(Table.Column(Manufacturers, "Country"), Table.Column(Manufacturers, "Company")),
				    Country = (name) => if name = null then "Unknown" else Record.FieldOrDefault(CountryMap, name, "Unknown"),
				    TypeKeys = List.Buffer(List.RemoveNulls(fnFactKeys("%Aircraft Type ID"))),
				    Base = Table.SelectRows(fnReadParquet("Data Files/CSVs/Aircraft_Base_File.parquet"), each List.Contains(TypeKeys, [AC_TYPEID])),
				    BaseRows = Table.FromRecords(Table.TransformRows(Base, each [#"%Aircraft Type ID" = [AC_TYPEID], #"%Aircraft Group Type" = [AC_GROUP], #"Aircraft Name" = [SSD_NAME], #"Aircraft Manufacturer" = [MANUFACTURER], #"Aircraft Manufacturer Country" = Country([MANUFACTURER]), #"Aircraft Name Full" = [LONG_NAME], #"Aircraft Name Abbreviated" = [SHORT_NAME], #"Aircraft Begin Date" = [BEGIN_DATE], #"Aircraft End Date" = [END_DATE], #"Aircraft Age Classification" = if [BEGIN_DATE] <> null and Date.Year([BEGIN_DATE]) < 1990 then "Classic" else "Current"]), {"%Aircraft Group Type", "%Aircraft Type ID", "Aircraft Name", "Aircraft Manufacturer", "Aircraft Manufacturer Country", "Aircraft Name Full", "Aircraft Name Abbreviated", "Aircraft Begin Date", "Aircraft End Date", "Aircraft Age Classification"}),
				    // LEFT JOIN Aircraft_Group.csv on [Aircraft Group ID] as [%Aircraft Group Type]
				    Groups = Table.RenameColumns(Table.SelectColumns(fnReadParquet("Data Files/CSVs/Aircraft_Group.parquet"), {"Aircraft Group ID", "Aircraft Engine Type", "Aircraft Number Of Engines"}), {{"Aircraft Group ID", "%Aircraft Group Type"}}),
				    Joined = Table.NestedJoin(BaseRows, {"%Aircraft Group Type"}, Groups, {"%Aircraft Group Type"}, "Group", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "Group", {"Aircraft Engine Type", "Aircraft Number Of Engines"}),
				    Dropped = Table.RemoveColumns(Expanded, {"%Aircraft Group Type"}),
				    // CONCATENATE Aircraft_2010_Update.csv: SubField(AC_GROUPNAME, ', ', 1 | 2), 'Current'
				    Update = Table.SelectRows(fnReadParquet("Data Files/CSVs/Aircraft_2010_Update.parquet"), each List.Contains(TypeKeys, [AC_TYPEID])),
				    SubField = (s, n) => let parts = if s = null then {} else Text.Split(s, ", ") in if List.Count(parts) >= n then parts{n - 1} else null,
				    UpdateRows = Table.FromRecords(Table.TransformRows(Update, each [#"%Aircraft Type ID" = [AC_TYPEID], #"Aircraft Engine Type" = SubField([AC_GROUPNAME], 1), #"Aircraft Number Of Engines" = SubField([AC_GROUPNAME], 2), #"Aircraft Name" = [SSD_NAME], #"Aircraft Manufacturer" = [MANUFACTURER], #"Aircraft Manufacturer Country" = Country([MANUFACTURER]), #"Aircraft Name Full" = [LONG_NAME], #"Aircraft Name Abbreviated" = [SHORT_NAME], #"Aircraft Begin Date" = [BEGIN_DATE], #"Aircraft End Date" = [END_DATE], #"Aircraft Age Classification" = "Current"]), {"%Aircraft Type ID", "Aircraft Name", "Aircraft Manufacturer", "Aircraft Manufacturer Country", "Aircraft Name Full", "Aircraft Name Abbreviated", "Aircraft Begin Date", "Aircraft End Date", "Aircraft Age Classification", "Aircraft Engine Type", "Aircraft Number Of Engines"}),
				    Combined = Table.Combine({Dropped, UpdateRows}),
				    Selected = Table.SelectColumns(Combined, {"%Aircraft Type ID", "Aircraft Name", "Aircraft Manufacturer", "Aircraft Manufacturer Country", "Aircraft Name Full", "Aircraft Name Abbreviated", "Aircraft Begin Date", "Aircraft End Date", "Aircraft Age Classification", "Aircraft Engine Type", "Aircraft Number Of Engines"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"%Aircraft Type ID", Int64.Type}, {"Aircraft Name", type text}, {"Aircraft Manufacturer", type text}, {"Aircraft Manufacturer Country", type text}, {"Aircraft Name Full", type text}, {"Aircraft Name Abbreviated", type text}, {"Aircraft Begin Date", type date}, {"Aircraft End Date", Int64.Type}, {"Aircraft Age Classification", type text}, {"Aircraft Engine Type", type text}, {"Aircraft Number Of Engines", type text}})
				in
				    Typed
