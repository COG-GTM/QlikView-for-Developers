	partition 'Destination Markets' = m
		mode: import
		source =
				let
				    Source = Table.SelectColumns(fnReadParquet("Data Files/CSVs/Destination Markets.parquet"), {"%Destination Airport Market ID", "Destination Market"}),
				    FactKeys = List.Buffer(List.RemoveNulls(fnFactKeys("%Destination Airport Market ID"))),
				    Kept = Table.SelectRows(Source, each List.Contains(FactKeys, [#"%Destination Airport Market ID"])),
				    Missing = List.Difference(FactKeys, Table.Column(Kept, "%Destination Airport Market ID")),
				    Unknown = Table.FromColumns({Missing, List.Repeat({"Unknown"}, List.Count(Missing))}, {"%Destination Airport Market ID", "Destination Market"}),
				    Combined = Table.Combine({Kept, Unknown}),
				    Typed = Table.TransformColumnTypes(Combined, {{"%Destination Airport Market ID", Int64.Type}, {"Destination Market", type text}})
				in
				    Typed