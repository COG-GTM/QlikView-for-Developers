	partition 'Origin Markets' = m
		mode: import
		source =
				let
				    Source = Table.SelectColumns(fnReadParquet("Data Files/CSVs/Origin Markets.parquet"), {"%Origin Airport Market ID", "Origin Market"}),
				    FactKeys = List.Buffer(List.RemoveNulls(fnFactKeys("%Origin Airport Market ID"))),
				    Kept = Table.SelectRows(Source, each List.Contains(FactKeys, [#"%Origin Airport Market ID"])),
				    Missing = List.Difference(FactKeys, Table.Column(Kept, "%Origin Airport Market ID")),
				    Unknown = Table.FromColumns({Missing, List.Repeat({"Unknown"}, List.Count(Missing))}, {"%Origin Airport Market ID", "Origin Market"}),
				    Combined = Table.Combine({Kept, Unknown}),
				    Typed = Table.TransformColumnTypes(Combined, {{"%Origin Airport Market ID", Int64.Type}, {"Origin Market", type text}})
				in
				    Typed