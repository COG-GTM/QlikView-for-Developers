table 'Main Data'
	lineageTag: 1d3d02cd-539d-5bed-878d-6a6793a333cc

	measure '# of Flights' = SUM('Main Data'[# Departures Performed])
		formatString: #,0
		lineageTag: c470fadb-cb2a-5932-bc61-fd1adafc259e

		annotation ParityKey = 1baea265cccd
		annotation QlikExpression = Sum ([# Departures Performed])
		annotation QlikObjects = CH01#1, CH02#1, CH04#3

	measure '# of Enplanned Passengers' = SUM('Main Data'[# Transported Passengers])
		formatString: #,0
		lineageTag: 3d6523fe-9a7b-5bee-955c-faa5693b44e6

		annotation ParityKey = 7f15ad08b3bb
		annotation QlikExpression = Sum ([# Transported Passengers])
		annotation QlikObjects = CH01#2, CH02#2, CH04#2, CH15#1

	measure 'Transported Freight' = SUM('Main Data'[# Transported Freight])
		formatString: #,0
		lineageTag: 1f592757-80c2-51a8-a1d4-555d6775661c

		annotation ParityKey = aea8a21aee5f
		annotation QlikExpression = Sum ([# Transported Freight])
		annotation QlikObjects = CH01#3, CH02#3

	measure 'Transported Mail' = SUM('Main Data'[# Transported Mail])
		formatString: #,0
		lineageTag: 28384f04-4a89-5fc2-a336-2da5958b7948

		annotation ParityKey = e0ca719214a7
		annotation QlikExpression = Sum ([# Transported Mail])
		annotation QlikObjects = CH01#4, CH02#4, CH04#1

	measure '# of Passengers (millions)' = DIVIDE(SUM('Main Data'[# Transported Passengers]), 1000000)
		formatString: #,0.00
		lineageTag: 8d0630de-de4f-5199-9314-621a5885fc28

		annotation ParityKey = 0c8ca154aacf
		annotation QlikExpression = ((Sum ([# Transported Passengers]) / 1000000))
		annotation QlikObjects = CH03#1, CH22#1, CH24#1, CH25#1, CH26#1, CH27#1, CH28#1

	measure '# of Available Seats (millions)' = DIVIDE(SUM('Main Data'[# Available Seats]), 1000000)
		formatString: #,0.00
		lineageTag: e7a7f010-173a-5aa2-8a7a-d4f0dd82f477

		annotation ParityKey = 8dfad31060e3
		annotation QlikExpression = ((Sum ([# Available Seats]) / 1000000))
		annotation QlikObjects = CH03#2

	measure 'Load Factor' = DIVIDE(SUM('Main Data'[# Transported Passengers]), SUM('Main Data'[# Available Seats]))
		formatString: 0.00%
		lineageTag: f1910841-c022-5970-9a02-a482ecc9c86e

		annotation ParityKey = 213681cc0d2a
		annotation QlikExpression = =((Sum ([# Transported Passengers]) / Sum ([# Available Seats])))
		annotation QlikObjects = CH03#3, CH05#1, CH21#1, CH38#1, CH38#2, CH41#1

	measure 'Performed vs Scheduled' = DIVIDE(SUM('Main Data'[# Departures Performed]), SUM('Main Data'[# Departures Scheduled]))
		formatString: 0.00%
		lineageTag: 1f9c57ff-2f6d-5c4f-9dfb-6da8d5a1757c

		annotation ParityKey = 7588bff24d2c
		annotation QlikExpression = ((Sum([# Departures Performed]) / Sum([# Departures Scheduled])))
		annotation QlikObjects = CH06#1, CH21#2, CH38#3, CH38#4

	measure 'Air Time %' = DIVIDE(SUM('Main Data'[# Air Time]), SUM('Main Data'[# Ramp-To-Ramp Time]))
		formatString: 0.00%
		lineageTag: 1dc68216-2329-5819-be58-8feb39c427de

		annotation ParityKey = cd4c4a3c94f4
		annotation QlikExpression = Sum ([# Air Time]) / Sum ([# Ramp-To-Ramp Time])
		annotation QlikObjects = CH07#1, CH08#1, CH09#1, CH11#1, CH12#1, CH13#1, CH14#1

	measure Carrier = IF(DISTINCTCOUNTNOBLANK('Main Data'[Carrier Name]) = 1, MAX('Main Data'[Carrier Name]), "Others")
		lineageTag: bcb491aa-bc19-5692-a5d2-0f9b1702711b

		annotation ParityKey = 90777bd5df7f
		annotation QlikExpression = if(count(distinct [Carrier Name]) = 1, [Carrier Name], 'Others')
		annotation QlikObjects = CH15#2

	measure 'Air Time % (CH21)' = DIVIDE(SUM('Main Data'[# Air Time]), SUM('Main Data'[# Ramp-To-Ramp Time]))
		formatString: 0.00%
		lineageTag: 68d150c1-4d4c-51b3-812f-4eb38fc4e49a

		annotation ParityKey = a1ec8a2cb5ee
		annotation QlikExpression = ((Sum ([# Air Time]) / Sum ([# Ramp-To-Ramp Time])))
		annotation QlikObjects = CH21#3, CH38#5, CH38#6

	measure 'Departures Performed (thousands)' = DIVIDE([# of Flights], 1000)
		formatString: #,0.00
		lineageTag: afc52f86-179b-5d3c-bcb2-624bbc78e785

		annotation ParityKey = 072410d4365a
		annotation QlikExpression = ((Sum ([# Departures Performed]) / 1000))
		annotation QlikObjects = CH22#2

