	partition 'Carrier Groups' = m
		mode: import
		source =
				let
				    Source = Table.SelectColumns(fnReadParquet("QVD/Source/Carrier Groups.parquet"), {"%Carrier Group ID", "Carrier Group"}),
				    FactKeys = List.Buffer(List.RemoveNulls(fnFactKeys("%Carrier Group ID"))),
				    Kept = Table.SelectRows(Source, each List.Contains(FactKeys, [#"%Carrier Group ID"])),
				    Missing = List.Difference(FactKeys, Table.Column(Kept, "%Carrier Group ID")),
				    Unknown = Table.FromColumns({Missing, List.Repeat({"Unknown"}, List.Count(Missing))}, {"%Carrier Group ID", "Carrier Group"}),
				    Combined = Table.Combine({Kept, Unknown}),
				    Typed = Table.TransformColumnTypes(Combined, {{"%Carrier Group ID", Int64.Type}, {"Carrier Group", type text}})
				in
				    Typed
