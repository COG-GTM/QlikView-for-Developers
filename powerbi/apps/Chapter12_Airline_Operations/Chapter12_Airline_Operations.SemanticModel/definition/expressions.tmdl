expression DataRoot = "C:\QlikView-for-Developers\powerbi\data\parquet\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: d592d646-1f31-5a29-b440-df004ae51ebe

expression fnReadParquet =
		(relativePath as text) as table =>
		let
		    FullPath = DataRoot & Text.Replace(relativePath, "/", "\"),
		    Source = Parquet.Document(File.Contents(FullPath))
		in
		    Source
	lineageTag: 1e310a9b-6d0a-5f74-ab74-69976bb46f81

expression fnFactKeys =
		// Distinct values of a [Main Data] field: QlikView's Exists() after the fact loads
		(column as text) as list =>
		let
		    Flight = fnReadParquet("Data Files/QVDs/Flight Data.parquet"),
		    Employment = fnReadParquet("Data Files/QVDs/T_F41SCHEDULE_P1A_EMP.parquet"),
		    FromTable = (t as table) => if Table.HasColumns(t, column) then Table.Column(t, column) else {},
		    Values = List.Distinct(FromTable(Flight) & FromTable(Employment))
		in
		    Values
	lineageTag: 4242d53c-0d04-576d-aa49-512351e459a6
