table 'Origin Markets'
	lineageTag: 29783e1d-95e8-5127-9312-b76a358626d9

	column '%Origin Airport Market ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 56b0bdbb-e7d5-5a66-8472-86ec60e9ae5d
		summarizeBy: none
