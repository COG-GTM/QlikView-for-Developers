	partition 'Group A Route' = m
		mode: import
		source =
				let
				    Source = Table.Distinct(Table.SelectColumns(#"Main Data", {"%Origin Airport ID", "%Destination Airport ID", "%Datasource ID", "Origin Country", "Origin State Code", "Origin City", "Destination Country", "Destination State Code", "Destination City"})),
				    J0 = Table.NestedJoin(Source, {"%Origin Airport ID"}, #"Origin Airports", {"%Origin Airport ID"}, "D0", JoinKind.LeftOuter),
				    E0 = Table.ExpandTableColumn(J0, "D0", {"Origin Airport"}),
				    J1 = Table.NestedJoin(E0, {"%Destination Airport ID"}, #"Destination Airports", {"%Destination Airport ID"}, "D1", JoinKind.LeftOuter),
				    E1 = Table.ExpandTableColumn(J1, "D1", {"Destination Airport"}),
				    J2 = Table.NestedJoin(E1, {"%Datasource ID"}, #"Flight Types", {"%Datasource ID"}, "D2", JoinKind.LeftOuter),
				    E2 = Table.ExpandTableColumn(J2, "D2", {"Flight Type"}),
				    Selected = Table.Distinct(Table.SelectColumns(E2, {"Origin Country", "Origin State Code", "Origin City", "Destination Country", "Destination State Code", "Destination City", "Origin Airport", "Destination Airport", "Flight Type"})),
				    Typed = Table.TransformColumnTypes(Selected, {{"Origin Country", type text}, {"Origin State Code", type text}, {"Origin City", type text}, {"Destination Country", type text}, {"Destination State Code", type text}, {"Destination City", type text}, {"Origin Airport", type text}, {"Destination Airport", type text}, {"Flight Type", type text}})
				in
				    Typed
